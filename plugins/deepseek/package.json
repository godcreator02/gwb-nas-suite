{
  "name": "@godcreator/gwb-deepseek",
  "version": "0.1.10",
  "author": {"name": "godcreator"},
  "license": "MIT",
  "description": "DeepSeek 命令插件：deepseek.chat 把模型调用原样发给 DeepSeek 并原样带回结果，deepseek.usage 按调用方汇总 token 用量；key、模型与 API 地址存在设置里。",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "skills", "LICENSE"],
  "keywords": ["gwb-plugin"],
  "repository": { "type": "git", "url": "https://github.com/godcreator02/gwb-nas-suite.git" },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests --tags-filter=!slow",
    "test:all": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-commands": "^0.6.0",
    "@godcreator/gwb-data": "^0.1.9",
    "@godcreator/gwb-settings": "^0.4.0",
    "@godcreator/gwb-skills": "^0.4.7"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
