{
  "name": "@godcreator/gwb-nas-board",
  "version": "0.1.3",
  "author": {"name": "godcreator"},
  "description": "NAS 体检看板：目前是 devkit 模板形状，一个窗格与一条 ping 命令；要做成读取 NAS 每日定案 JSON 画状态的看板，设计见文档站未来区的实施方案。",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "keywords": ["gwb-plugin"],
  "publishConfig": { "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/" },
  "scripts": {
    "build": "node build.ts && tailwindcss -i src/client/styles.css -o dist/style.css",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.7.2",
    "@godcreator/gwb-commands": "^0.5.2",
    "@godcreator/gwb-shell": "^0.15.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
